{
    "name": "nuewire/installer",
    "description": "Interactive installer and updater for Nuewire Laravel packages.",
    "keywords": [
        "laravel",
        "installer",
        "composer",
        "artisan",
        "nuewire"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Nuewire"
        }
    ],
    "require": {
        "composer-runtime-api": "^2.2",
        "illuminate/auth": "^11.0|^12.0|^13.0",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/translation": "^11.0|^12.0|^13.0",
        "illuminate/validation": "^11.0|^12.0|^13.0",
        "illuminate/view": "^11.0|^12.0|^13.0",
        "laravel/prompts": "^0.1.18|^0.2.0|^0.3.17",
        "nuewire/support": "^1.0",
        "php": "^8.2",
        "psr/log": "^1.1|^2.0|^3.0",
        "symfony/process": "^7.0|^8.0"
    },
    "require-dev": {
        "livewire/livewire": "^3.6|^4.0.3",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Nuewire\\Installer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nuewire\\Installer\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nuewire\\Installer\\InstallerServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "livewire/livewire": "Required for the optional web update interface.",
        "nuewire/platform": "Adds the package update page to the Nuewire admin navigation."
    }
}
